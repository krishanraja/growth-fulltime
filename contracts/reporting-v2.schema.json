{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KrishanRaja/growth-fulltime/contracts/reporting-v2.schema.json",
  "title": "Full Time growth handoff report, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "engine_product", "product_slug", "venture", "policy_version", "report_id", "revision", "delivery", "pack", "required_capabilities"],
  "properties": {
    "contract_version": {"const": 2},
    "engine_product": {"const": "fulltime"},
    "product_slug": {"const": "full-time"},
    "venture": {"const": "full_time"},
    "policy_version": {"const": "fulltime-brand-zero-cash-v1"},
    "report_id": {"type": "string", "pattern": "^fulltime:[0-9]{4}-[0-9]{2}-[0-9]{2}:(daily|report|numbers|radar|conversion)$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "write_attempted"],
      "properties": {"status": {"const": "pending_handoff"}, "write_attempted": {"const": false}}
    },
    "pack": {
      "type": "object",
      "required": ["pack_date", "kind", "venture", "fulltime_sha", "headline", "items"],
      "properties": {
        "venture": {"const": "fulltime"},
        "fulltime_sha": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
        "pack_date": {"type": "string", "format": "date"},
        "kind": {"enum": ["daily", "report", "numbers", "radar", "conversion"]},
        "headline": {"type": "string", "minLength": 1},
        "items": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/item"}},
        "metrics": {"type": "array", "items": {"type": "object"}}
      }
    },
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["product_isolation", "stable_item_ids", "holds", "provenance", "typed_metrics", "publication_receipts"]}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["item_id", "platform", "text", "holds", "readiness"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "platform": {"enum": ["other", "site", "youtube", "whatsapp", "email", "tiktok", "instagram", "x", "reddit"]},
        "text": {"type": "string", "minLength": 1},
        "holds": {"type": "array", "uniqueItems": true, "items": {"enum": ["RAIL", "RELEASE", "CHANNEL", "CONSENT", "DATA", "ASSETS", "APPROVAL", "D1", "D2", "D3", "D4", "D5", "D6", "D7"]}},
        "readiness": {"enum": ["held", "ready"]},
        "creative_id": {"type": "string"},
        "experiment_id": {"type": "string"},
        "assets": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
