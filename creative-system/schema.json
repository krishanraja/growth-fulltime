{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krishanraja/growth-fulltime/creative-system/schema.json",
  "title": "Creative system records, bounded offline vocabulary",
  "$defs": {
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "approval_scope",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "observable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "media": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "script",
              "audio",
              "image",
              "video"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "state": {
          "type": "string",
          "enum": [
            "owner_requirement",
            "candidate_interpretation",
            "awaiting_evidence"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        },
        "regression_risk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "instruction",
        "observable",
        "media",
        "state",
        "evidence_ids",
        "regression_risk"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "shared"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "enum": [
            "fictional_ad",
            "product_reference"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "captured_requirements",
            "awaiting_evidence"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "canonical_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0,
          "maxItems": 12
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "kind",
        "name",
        "surface",
        "status",
        "summary",
        "owns",
        "depends_on",
        "canonical_ref",
        "rules"
      ],
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "captured_baseline",
            "candidate",
            "owner_promoted"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          },
          "minItems": 1
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shared": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/file_ref"
        },
        "cases": {
          "$ref": "#/$defs/file_ref"
        },
        "archive": {
          "$ref": "#/$defs/file_ref"
        },
        "locks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lock"
          },
          "minItems": 0
        },
        "addressed_feedback": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "status",
        "purpose",
        "modules",
        "characters",
        "shared",
        "evidence",
        "cases",
        "archive",
        "locks",
        "addressed_feedback",
        "limitations",
        "next_action"
      ],
      "additionalProperties": false
    },
    "pointer": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "release",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evidence_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker": {
          "type": "string",
          "enum": [
            "user"
          ]
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "explicit_requirement",
            "artifact_approval",
            "artifact_rejection",
            "scoped_correction",
            "architecture_request"
          ]
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0
        },
        "historical": {
          "type": "boolean"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "quote",
        "source_ref",
        "occurred_at",
        "speaker",
        "situation",
        "classification",
        "artifact_ids",
        "historical",
        "superseded_by"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "holdout_status": {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        "creative_baseline": {
          "type": "null"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "scope",
        "holdout_status",
        "creative_baseline",
        "items"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "reference_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0
        },
        "always_run": {
          "type": "boolean"
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "synthetic_canary",
            "owner_graded_reference"
          ]
        },
        "holdout": {
          "const": false
        }
      },
      "required": [
        "id",
        "modules",
        "criteria",
        "prompt",
        "reference_asset_ids",
        "always_run",
        "evidence_class",
        "holdout"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "items"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "enum": [
            "rejected_dimensions",
            "requirements",
            "scoped_approval"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "occurred_at",
        "quote",
        "source_ref",
        "modules",
        "artifact_ids",
        "scope",
        "effect",
        "notes"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "holds",
            "breaks",
            "not_assessed",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "criterion",
        "verdict",
        "evidence"
      ],
      "additionalProperties": false
    },
    "artifact_review": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "reviewer_kind": {
          "type": "string",
          "enum": [
            "owner",
            "model",
            "technical"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "release_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "production_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assets_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "reviewer_kind",
        "source_ref",
        "release_sha256",
        "production_sha256",
        "assets_sha256",
        "findings"
      ],
      "additionalProperties": false
    },
    "production_asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "release_path": {
          "type": "string",
          "minLength": 1
        },
        "release_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "medium": {
          "type": "string",
          "enum": [
            "script",
            "audio",
            "image",
            "video"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/production_asset"
          },
          "minItems": 1
        },
        "technical_pass": {
          "type": "boolean"
        },
        "addressed_feedback": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "external_holds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "id",
        "release_path",
        "release_sha256",
        "characters",
        "medium",
        "assets",
        "technical_pass",
        "addressed_feedback",
        "external_holds"
      ],
      "additionalProperties": false
    },
    "comparison_finding": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "baseline": {
          "type": "string",
          "enum": [
            "holds",
            "breaks",
            "not_assessed",
            "not_applicable"
          ]
        },
        "candidate": {
          "type": "string",
          "enum": [
            "holds",
            "breaks",
            "not_assessed",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "criterion",
        "baseline",
        "candidate",
        "evidence"
      ],
      "additionalProperties": false
    },
    "regression_review": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_kind": {
          "type": "string",
          "enum": [
            "owner",
            "model",
            "technical"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison_finding"
          },
          "minItems": 1
        },
        "preference": {
          "type": "string",
          "enum": [
            "candidate",
            "baseline",
            "tie",
            "not_judged"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "case_sha256",
        "baseline_sha256",
        "candidate_sha256",
        "baseline_artifact_sha256",
        "candidate_artifact_sha256",
        "reviewer_kind",
        "source_ref",
        "findings",
        "preference",
        "reason"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "reviewer_kind": {
          "type": "string",
          "enum": [
            "owner",
            "model"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "decline"
          ]
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "reviewer_kind",
        "decision",
        "candidate_sha256",
        "review_set_sha256",
        "source_ref"
      ],
      "additionalProperties": false
    }
  }
}
